      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (country) (count_over_time({job=\"cowrie\", eventid=\"cowrie.session.connect\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 1
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Útoky",
            "location": {
              "mode": "lookup",
              "lookup": "country",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "Value #A",
                  "min": 5,
                  "max": 30,
                  "fixed": 8
                },
                "color": {
                  "fixed": "red"
                },
                "opacity": 0.6
              }
            }
          }
        ]
      }
    },
